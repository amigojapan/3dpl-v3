mv("dragon_head",0,0,-(Input.GetKey(KeyCode.UpArrow) ? 1 : Input.GetKey(KeyCode.DownArrow) ? -1 : 0)*10);
rt("dragon_head",0,(Input.GetKey(KeyCode.RightArrow) ? 1 : Input.GetKey(KeyCode.LeftArrow) ? -1 : 0)*40,0);
sp("camera",vars["dragon_head"].position.x-1,vars["dragon_head"].position.y+12,vars["dragon_head"].position.z-30);
window.debugString=vars["dragon_head"].eulerAngles.y.toString();
if(Input.GetKey(KeyCode.Space)){
    mv("dragon_head",0,3,0);
}
if(Input.GetKey(KeyCode.S)){
    mv("dragon_head",0,-3,0);
}
for(var i=0;i<6;i++){
    ((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["dragon_body"+i], 0,Math.sin(vars["rad"]-(i*Math.PI/7))/15,0);
}
//Pが押されたとき
if (Input.GetKey(KeyCode.RightControl)) {
    window.debugString = vars["time"].toString();
    //0.1秒ごとに処理
    if (vars["time"] >= 0.1) {
        window.debugString = "herez2";
        //ブレスの最初のボクセルのとき
        if (vars["breathCount"] == 0) {
            vars["Fire" + vars["breathCount"]] = qb("fire" + vars["breathCount"], vars["BreathOrigine"].position.x, vars["BreathOrigine"].position.y, vars["BreathOrigine"].position.z);
            var x = (0 + Math.random() * (2 - 0));
            window.debugString = "herez3";
            //xが1以下の時
            if (x < 1) {
                cl("fire" + vars["breathCount"], 0xf6f337);
                //Xが1以上の時
            } else {
                cl("fire" + vars["breathCount"], 0xad4e1a);
            }
            window.debugString = "herez4";

            vars["breathCount"] = vars["breathCount"] + 1;
            //ブレスのボクセルが2個目以降の時
        } else {
            for (var k = 0; k < vars["breathCount"]; k++) {
                ((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["Fire" + k.toString()], -Math.sin((Math.PI / 180) * (vars["dragon_head"].eulerAngles.y)), 0, -Math.cos((Math.PI / 180) * (vars["dragon_head"].eulerAngles.y)));
                window.debugString = "fire" + k.toString();
                
                //SHAKE TOKYO TOWER
                if (cd("fire" + k.toString(), "TT")) {
                  if(vars["TT_SDC"]>=0) {
                    vars["TT_SDC"]=vars["TT_SDC"]-1;
                  }
                  //Shaking things up when hit
                  mv("TT",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                  an("TT",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                }
                //END
                
                 //SHAKE SENSOUJI
                if (cd("fire" + k.toString(), "SS")) {
                  if(vars["SS_SDC"]>=0) {
                    vars["SS_SDC"]=vars["SS_SDC"]-1;
                  }
                  //Shaking things up when hit
                  mv("SS",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                  an("SS",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                }
                //END
                
                //SHAKE HOUSE 1
                if (cd("fire" + k.toString(), "H1")) {
                  if(vars["H1_SDC"]>=0) {
                    vars["H1_SDC"]=vars["H1_SDC"]-1;
                  }
                  //Shaking things up when hit
                  mv("H1",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                  an("H1",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                }
                //END
                
                //SHAKE HIGH TOWER
                if (cd("fire" + k.toString(), "HT")) {
                  if(vars["HT_SDC"]>=0) {
                    vars["HT_SDC"]=vars["HT_SDC"]-1;
                  }
                  //Shaking things up when hit
                  mv("HT",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                  an("HT",Math.round(3*(-1 + Math.random() * (2 - -1))),0,0);
                }
                //END
                
                
                
                if (ex("fire" + vars["breathCount"])) {
                    dl("fire" + vars["breathCount"]);
                }
                vars["Fire" + vars["breathCount"]] = qb("fire" + vars["breathCount"], vars["BreathOrigine"].position.x + (4 * Math.sin(vars["breathCount"] % 8 * 2 * Math.PI / 8)), vars["BreathOrigine"].position.y, vars["BreathOrigine"].position.z);
                window.debugString = "herez6";
                var y = (0 + Math.random() * (2 - 0));
                if (y < 1) {
                    cl("fire" + vars["breathCount"], 0xf6f337);
                } else {
                    cl("fire" + vars["breathCount"], 0xad4e1a);
                }
            }
            //二週目ここまで
            
            window.debugString = "herez6";
            vars["breathCount"] = vars["breathCount"] + 1;
            if (vars["breathCount"] >= 50) {
                vars["breathCount"] = 0;
            }
            
            window.debugString = "herez7";
            vars["time"] = 0;
        }//0.1秒たっていたときここまで
    }
    vars["time"] += Time.deltaTime;
        
    //window.debugString = "herez8";

}//Pが押されていたときここまで
else {
    for (var l = 0; l < vars["breathCount"]; l++) {
        ((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["Fire" + l.toString()], -Math.sin((Math.PI / 180) * (vars["dragon_head"].eulerAngles.y)), 0, -Math.cos((Math.PI / 180) * (vars["dragon_head"].eulerAngles.y)));
    }
}
vars["rad"]=vars["rad"]+0.3;


//DESTROY FOR ALL
var xx;

//DESTROY TOKYO TOWER
if(vars["TT_SDC"]<=0) {
	vars["TT_SDC"]=vars["TT_SDC"]-1;
	//explosion
	for (let xx =0; xx< vars["TokyoTower"].children.length; xx++) {
		vars["myobj"] = vars["TokyoTower"].children[xx];
		((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["myobj"], (-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)));
		window.debugString = vars["TT_SDC"].toString();
		if(vars["TT_SDC"]<-20) {
			dl("TT");
			//vars["myobj"].removeFromParent();
		}
	}
}
//END

//DESTROY SENSOUJI
if(vars["SS_SDC"]<=0) {
	vars["SS_SDC"]=vars["SS_SDC"]-1;
	//explosion
	for (let xx =0; xx< vars["Sen"].children.length; xx++) {
		vars["myobj"] = vars["Sen"].children[xx];
		((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["myobj"], (-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)));
		window.debugString = vars["SS_SDC"].toString();
		if(vars["SS_SDC"]<-20) {
			dl("SS");
			//vars["myobj"].removeFromParent();
		}
	}
}
//END

//DESTROY HOUSE 1
if(vars["H1_SDC"]<=0) {
	vars["H1_SDC"]=vars["H1_SDC"]-1;
	//explosion
	for (let xx =0; xx< vars["Hou"].children.length; xx++) {
		vars["myobj"] = vars["Hou"].children[xx];
		((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["myobj"], (-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)));
		window.debugString = vars["H1_SDC"].toString();
		if(vars["H1_SDC"]<-20) {
			dl("H1");
			//vars["myobj"].removeFromParent();
		}
	}
}
//END

//DESTROY HIGH TOWER
if(vars["HT_SDC"]<=0) {
	vars["HT_SDC"]=vars["HT_SDC"]-1;
	//explosion
	for (let xx =0; xx< vars["Hig"].children.length; xx++) {
		vars["myobj"] = vars["Hig"].children[xx];
		((object, x, y, z) => { object.translateX(x); object.translateY(y); object.translateZ(-z); })(vars["myobj"], (-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)),(-7.0 + Math.random() * (7.0 - -7.0)));
		window.debugString = vars["HT_SDC"].toString();
		if(vars["HT_SDC"]<-20) {
			dl("HT");
			//vars["myobj"].removeFromParent();
		}
	}
}
//END
