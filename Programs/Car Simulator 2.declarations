vars["land"] = LoadMap("THEMAP.json", "land");
vars["car"]=Obj("sport_car.json","car0",0,0,-7);
sc("car0",-0.9,-0.9,-0.9);
vars["tire1"]=Obj("sport_car_tires.json","tire1",0,0,0);
sc("tire1",-0.95,-0.95,-0.95);
vars["tire2"]=Obj("sport_car_tires.json","tire2",0,0,0);
sc("tire2",-0.95,-0.95,-0.95);
vars["tire3"]=Obj("sport_car_tires.json","tire3",0,0,0);
sc("tire3",-0.95,-0.95,-0.95);
vars["tire4"]=Obj("sport_car_tires.json","tire4",0,0,0);
