sp("tire1",vars["car"].transform.position.x-0.4,vars["car"].transform.position.y,vars["car"].transform.position.z-0.6);
sp("tire2",vars["car"].transform.position.x+0.4,vars["car"].transform.position.y,vars["car"].transform.position.z-0.6);
sp("tire3",vars["car"].transform.position.x-0.4,vars["car"].transform.position.y,vars["car"].transform.position.z+0.1);
