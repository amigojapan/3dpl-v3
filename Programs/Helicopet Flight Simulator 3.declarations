vars["land"] = LoadMap("THEMAP.json", "land");
vars["car"]=Obj("Futuristic_Helycopter_without_wings_with_colliders.json","car0",-39.62049,41.35633,107.3032);
//vars["car"].transform.localScale = Vector3(0,0,0); // make it face opposite y direction
sc("car0",-0.9,-0.9,-0.9);
vars["tire1"]=Obj("Futuristic_Helycopter_propeller.json","tire1",0,0,0);
sc("tire1",-0.9,-0.9,-0.9);
sp("tire1",vars["car"].transform.position.x,vars["car"].transform.position.y,vars["car"].transform.position.z);
vars["tire1"].transform.parent=vars["car"].transform;
//Attach Sound to car
AttachSound("car0","helicopter.wav");
PlaySoundLoop("car0");
//Music
AttachSound("camera","NOW1.wav");
PlaySoundLoop("camera");
SetVolume("camera", 0.05);//Music is too loud, so lower volume
